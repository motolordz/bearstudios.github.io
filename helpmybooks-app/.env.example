# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — leave ALL of these out entirely for mock mode (do not use placeholders)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM=notifications@helpmybooks.com

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Xero OAuth 2.0
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3000/api/xero/callback

# 32-byte key (base64 or hex) used to encrypt Xero tokens at rest.
# Generate with: openssl rand -base64 32
XERO_TOKEN_ENCRYPTION_KEY=

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Cron protection (set to a random string in Vercel; cron requests must send it as a Bearer token)
CRON_SECRET=
